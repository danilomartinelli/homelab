# Shape of secrets/services.yaml. This file is a template committed in
# plaintext — it documents the keys, never the values.
#
# The real file is edited with:
#   sops secrets/services.yaml
# which opens $EDITOR and re-encrypts on save to the recipients in
# .sops.yaml (this laptop's age key + kodo's SSH host key). Credentials
# therefore never transit a terminal, a chat window, or shell history.
#
# ---------------------------------------------------------------------------
# restic — backups to Cloudflare R2
# ---------------------------------------------------------------------------
#
# restic:
#   repository: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
#   password: <generate: openssl rand -base64 32>
#   r2-env: |
#     AWS_ACCESS_KEY_ID=<R2 Access Key ID>
#     AWS_SECRET_ACCESS_KEY=<R2 Secret Access Key>
#
#   repository — R2 speaks the S3 API. The `s3:` prefix selects that backend.
#
#   password — restic's encryption key. There is no recovery path: lose it
#   and every snapshot is permanently unreadable. Store a copy in a password
#   manager before the first backup runs, not after.
#
#   r2-env — consumed as a systemd EnvironmentFile, so KEY=VALUE lines only:
#   no `export`, no quotes, no trailing whitespace.
#
# ---------------------------------------------------------------------------
# hermes — model provider keys
# ---------------------------------------------------------------------------
#
# hermes:
#   env: |
#     OPENCODE_API_KEY=<opencode-go / zen gateway>
#     OPENROUTER_API_KEY=<claude, glm, kimi, minimax via one gateway>
#     GEMINI_API_KEY=<Google AI Studio>
#     ZHIPU_API_KEY=<GLM direct>
#     MOONSHOT_API_KEY=<Kimi direct>
#     TAVILY_API_KEY=<web search tool>
#     CONTEXT7_API_KEY=<docs retrieval tool>
#     MINIMAX_API_KEY=<MiniMax direct>
#
#   Read as a Docker env_file, so the same KEY=VALUE constraints apply.
#
# ---------------------------------------------------------------------------
# hermes — WhatsApp Cloud API
# ---------------------------------------------------------------------------
#
# hermes:
#   whatsapp-cloud-env: |
#     WHATSAPP_ENABLED=true
#     WHATSAPP_MODE=cloud
#     WHATSAPP_CLOUD_ACCESS_TOKEN=<permanent System User token>
#     WHATSAPP_CLOUD_APP_ID=<Meta app id>
#     WHATSAPP_CLOUD_APP_SECRET=<Meta app secret>
#     WHATSAPP_CLOUD_PHONE_NUMBER_ID=<phone number id, NOT the phone number>
#     WHATSAPP_CLOUD_WABA_ID=<WhatsApp Business Account id>
#     WHATSAPP_CLOUD_VERIFY_TOKEN=<you invent this; must match Meta's field>
#     WHATSAPP_CLOUD_ALLOWED_USERS=<your own number, digits only, e.g. 5511999999999>
#
#   Deliberately a SEPARATE key from hermes.env, not extra lines inside it.
#   `hermes gateway run` logs "No messaging platforms enabled" and exits 0
#   when no channel is configured, and Docker's restart policy turns a clean
#   exit into an invisible restart loop — observed climbing RestartCount 3→4
#   in twelve seconds while `docker ps` still said "(healthy)". Splitting the
#   WhatsApp credentials into their own secret makes "is WhatsApp
#   configured?" a filesystem question, which the systemd unit answers with
#   ConditionPathExists rather than by crashing.
#
#   ACCESS_TOKEN — use a permanent System User token from Meta Business
#   Suite. The 24-hour token shown in the app dashboard's quickstart expires
#   overnight and the gateway will start failing silently the next day.
#
#   PHONE_NUMBER_ID — an opaque numeric id from the WhatsApp > API Setup
#   page, not the dialable number. Passing the phone number here fails with
#   an unhelpful Meta error.
#
#   VERIFY_TOKEN — an arbitrary string you choose. Meta echoes it during the
#   webhook subscription handshake and the gateway compares them; it is not
#   issued by Meta. Generate one: openssl rand -hex 24
#
#   ALLOWED_USERS — comma-separated, digits only, no `+` and no JID suffix
#   (parsed by _coerce_allow_list in gateway/platforms/whatsapp_common.py).
#   Without it WHATSAPP_DM_POLICY defaults to `pairing` and unknown senders
#   are denied — which is the correct default. Do NOT set
#   GATEWAY_ALLOW_ALL_USERS=true: this agent has terminal and file access on
#   the host, so an open channel is remote code execution for anyone who
#   learns the number.
