{
	# Let's Encrypt needs a contact address for expiry warnings.
	# Replace if you prefer a different mailbox.
	email danilomartinelli429@gmail.com

	# Admin API off: it binds 2019 with no auth and this host now has a
	# public interface. Nothing here needs runtime reconfiguration.
	admin off
}

# WhatsApp Cloud API webhook.
#
# This is the only public entry point on the machine. Everything else
# (SSH aside) reaches kodo through Tailscale.
#
# Meta requires a publicly reachable HTTPS endpoint to POST inbound
# messages. Caddy terminates TLS with an automatic Let's Encrypt
# certificate and forwards to the Hermes gateway on loopback.
hermes.witek.sh {
	# Only the webhook path is proxied. A bare `reverse_proxy` at the site
	# root would expose whatever else the gateway happens to listen on;
	# scoping to the exact path Meta calls keeps the public surface to one
	# route.
	#
	# The path matches WHATSAPP_CLOUD_WEBHOOK_PATH (default
	# /whatsapp/webhook, read from gateway/platforms/whatsapp_cloud.py).
	handle /whatsapp/webhook* {
		reverse_proxy 127.0.0.1:8090 {
			# Meta retries on 5xx, so a slow model call must not look like
			# a failure. The gateway acknowledges before processing.
			transport http {
				read_timeout 30s
			}
		}
	}

	# Everything else gets a flat 404 with no body — no server banner, no
	# directory listing, no hint that anything else runs here.
	handle {
		respond 404
	}

	# Security headers. Modest value for a webhook endpoint, but free.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	log {
		output file /var/log/caddy/hermes.witek.sh.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Webhook bodies carry message contents. Log metadata only.
		format json
	}
}
