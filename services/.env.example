# Default-format env keys for the homelab services. The real file lives at
# secrets/services.yaml (sops-encrypted) and is decrypted at activation time
# into the system. Mirror the structure here so editors and humans know what
# keys exist; never put real values in this file.

# --- Tailscale ---
# Auth key generated from https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=

# --- Backups (restic -> Backblaze B2) ---
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# RESTIC_REPOSITORY=b2:homelab-bucket:/restic
# RESTIC_PASSWORD=

# --- Public hostname for the homelab ---
# TAILSCALE_HOSTNAME=homelab
